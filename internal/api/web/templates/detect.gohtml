{{- define "title"}}Detect{{end -}}
<h2>Live card detection</h2>

<select id="camera">
    <option>loading camera</option>
</select>
<div id="status">Loading ...</div>

<div class="preview">
  <video id="videoInput" playsinline muted></video>
  <canvas id="overlay"></canvas>
</div>

<detect-result>
  <dialog id="detect-result">
    <div data-card></div>
    <button type="button" class="btn btn-small match-prev" aria-label="Previous match">&lsaquo;</button>
    <button type="button" class="btn btn-small match-next" aria-label="Next match">&rsaquo;</button>
  </dialog>
</detect-result>

<script defer src="{{ asset "js/opencv-4.13.0.min.js" }}" type="text/javascript"></script>
<script type="module" src="{{ asset "js/detect.js" }}"></script>
