{{ define "collect_action" }}
<div
    hx-target="this"
    hx-swap="outerHTML"
    class="btn-group card-actions"
    role="group"
>
  <button
      class="btn btn-primary remove"
      {{ if .Amount  }}data-testid="remove-card-btn"{{ else }}disabled{{ end }}
      hx-post="/mycards"
      hx-vals='{ "id": "{{ .ID }}","amount": {{ .Amount.Previous }} }'
  >&minus;</button>
  <button class="btn btn-text-only amount">{{ .Amount }}</button>
  <button
      class="btn btn-primary add"
      hx-post="/mycards"
      hx-vals='{ "id": "{{ .ID }}","amount": {{ .Amount.Next }} }'
      data-testid="add-card-btn"
  >+</button>
</div>
{{ end }}
